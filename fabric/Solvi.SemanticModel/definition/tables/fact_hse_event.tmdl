table fact_hse_event
	lineageTag: 14606743-14c8-5f7a-babc-ba57c4666de4

	measure Incidents = CALCULATE ( COUNTROWS ( fact_hse_event ), fact_hse_event[event_type] = "Incident" )
		formatString: #,0
		displayFolder: HSE
		lineageTag: 5f2c5d73-fe9d-50a5-89a1-a146b7afeda1

	measure 'Near misses' = CALCULATE ( COUNTROWS ( fact_hse_event ), fact_hse_event[event_type] = "Near miss" )
		formatString: #,0
		displayFolder: HSE
		lineageTag: 266dd0eb-f24f-5bd3-9675-dbd5d5bfe210

	measure 'Good catches' = CALCULATE ( COUNTROWS ( fact_hse_event ), fact_hse_event[event_type] = "Good catch" )
		formatString: #,0
		displayFolder: HSE
		lineageTag: c42a0897-22d0-5f8e-8ba9-d0b171f664bf

	measure 'Events per 100 jobs' = DIVIDE ( [Incidents] + [Near misses], [Battery jobs] ) * 100
		formatString: #,0.0
		displayFolder: HSE
		lineageTag: 35868556-4496-5322-8364-78cdd5a9f33f

	measure 'Days since last incident' = VAR last_incident = CALCULATE ( MAX ( fact_hse_event[event_date] ), fact_hse_event[event_type] = "Incident", REMOVEFILTERS () ) RETURN IF ( NOT ISBLANK ( last_incident ), DATEDIFF ( last_incident, [As of date], DAY ) )
		formatString: #,0
		displayFolder: HSE
		lineageTag: 8db85744-783f-5802-86ae-c1144761887d

