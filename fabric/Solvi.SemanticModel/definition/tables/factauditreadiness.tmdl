table 'Audit readiness'
	lineageTag: fdaff7eb-76b3-53c7-bd2e-2013f34fc899

	measure 'Audit-ready share' = DIVIDE ( CALCULATE ( COUNTROWS ( 'Audit readiness' ), 'Audit readiness'[Audit ready] = TRUE () ), COUNTROWS ( 'Audit readiness' ) )
