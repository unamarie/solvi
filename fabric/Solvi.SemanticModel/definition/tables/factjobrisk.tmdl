table 'Battery job'
	lineageTag: d45ed398-b7c1-517f-8853-0e4880d0bb14

	measure 'As of date' = DATE ( 2026, 10, 31 )
		formatString: yyyy-mm-dd
		displayFolder: Settings
		lineageTag: cf8d19de-d914-5282-97f0-1366a6676597

	measure 'Battery jobs' = CALCULATE ( COUNTROWS ( 'Battery job' ), 'Battery job'[Status] = "Done" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: 6cc98be7-3bf6-5158-a5b1-e47544903b39

	measure 'Red jobs' = CALCULATE ( [Battery jobs], 'Battery job'[Risk level] = "Red" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: 7c3bdfe1-502a-5b32-a7ce-cc7bdee736c2

	measure 'Yellow jobs' = CALCULATE ( [Battery jobs], 'Battery job'[Risk level] = "Yellow" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: 2535494f-d39f-542f-948f-c3dfbae5aac6

	measure 'Red job share' = DIVIDE ( [Red jobs], [Battery jobs] )
		formatString: 0.0%
		displayFolder: Risk
		lineageTag: 6424b7e5-5395-57dd-9b91-6db2c4a80541

	measure 'Planned jobs' = CALCULATE ( COUNTROWS ( 'Battery job' ), 'Battery job'[Status] = "Planned" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: a32838ce-ad29-5965-85b7-6db65e2022e6

	measure 'Planned red jobs' = CALCULATE ( [Planned jobs], 'Battery job'[Risk level] = "Red" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: c5ba05c6-b972-5e53-8a3e-810ce45f7081

	measure 'Average risk score' = AVERAGE ( 'Battery job'[Risk score] )
		formatString: #,0.0
		displayFolder: Risk
		lineageTag: d6aaebde-4302-511c-91ac-3caa83e4e4a7

