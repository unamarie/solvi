table fact_job_risk
	lineageTag: 76d3eab6-50b7-5eef-a752-096ffae2409c

	measure 'As of date' = DATE ( 2026, 10, 31 )
		formatString: yyyy-mm-dd
		displayFolder: Settings
		lineageTag: 4e1b4835-229e-50b2-979d-e246d729c479

	measure 'Battery jobs' = CALCULATE ( COUNTROWS ( fact_job_risk ), fact_job_risk[status] = "Done" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: 4122b6de-8df5-5410-8e7c-470c0c854d20

	measure 'Red jobs' = CALCULATE ( [Battery jobs], fact_job_risk[risk_level] = "Red" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: f8b83afc-b1bb-570a-8467-46fac29fa422

	measure 'Yellow jobs' = CALCULATE ( [Battery jobs], fact_job_risk[risk_level] = "Yellow" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: b97a19a6-5a1c-5c04-b895-71bb22342a1e

	measure 'Red job share' = DIVIDE ( [Red jobs], [Battery jobs] )
		formatString: 0.0%
		displayFolder: Risk
		lineageTag: a8896f56-fc3e-5172-8f10-ecd8dcc78aad

	measure 'Planned jobs' = CALCULATE ( COUNTROWS ( fact_job_risk ), fact_job_risk[status] = "Planned" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: 4cb99ab7-2808-5838-a157-9379a7d4c0d6

	measure 'Planned red jobs' = CALCULATE ( [Planned jobs], fact_job_risk[risk_level] = "Red" )
		formatString: #,0
		displayFolder: Risk
		lineageTag: 1cedc4b1-27ef-5f6c-b41e-b08ee848f531

	measure 'Average risk score' = AVERAGE ( fact_job_risk[risk_score] )
		formatString: #,0.0
		displayFolder: Risk
		lineageTag: f2b64c24-f9c8-5d07-b077-8a39a49677a9

