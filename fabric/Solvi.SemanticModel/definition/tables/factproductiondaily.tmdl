		summarizeBy: none
		sourceColumn: snow_on_panels

	column 'Ratio 7d'
		dataType: double
		lineageTag: e3c77cd9-63af-55e6-8ba6-33ade78eea5d
		summarizeBy: none
		sourceColumn: ratio_7d

	column Underperforming
		dataType: boolean
		lineageTag: 15623b33-9745-556d-a0a4-a42632978477
