table 'HSE event'
	lineageTag: 2e73a89e-6649-56b1-b7eb-14124cf86598

	measure Incidents = CALCULATE ( COUNTROWS ( 'HSE event' ), 'HSE event'[Event type] = "Incident" )
		formatString: #,0
		displayFolder: HSE
		lineageTag: 64f6e964-df94-5b62-ab35-23718ac37e14

	measure 'Near misses' = CALCULATE ( COUNTROWS ( 'HSE event' ), 'HSE event'[Event type] = "Near miss" )
		formatString: #,0
		displayFolder: HSE
		lineageTag: de0659f5-3a77-5f75-994f-ae041962f917

	measure 'Good catches' = CALCULATE ( COUNTROWS ( 'HSE event' ), 'HSE event'[Event type] = "Good catch" )
		formatString: #,0
		displayFolder: HSE
		lineageTag: 9fac5376-3b70-57cc-b1e9-25b475a1d406

	measure 'Events per 100 jobs' = DIVIDE ( [Incidents] + [Near misses], [Battery jobs] ) * 100
		formatString: #,0.0
		displayFolder: HSE
		lineageTag: 4275e202-7336-5ec9-8fa9-77bbecb09431

	measure 'Days since last incident' = VAR lastIncident = CALCULATE ( MAX ( 'HSE event'[Event date] ), 'HSE event'[Event type] = "Incident", REMOVEFILTERS () ) RETURN IF ( NOT ISBLANK ( lastIncident ), DATEDIFF ( lastIncident, [As of date], DAY ) )
		formatString: #,0
		displayFolder: HSE
		lineageTag: 4452003c-35b4-5ed2-ae77-1812a012c19a

	column 'Event ID'
		dataType: string
		lineageTag: 9ee1a96c-012b-5968-8200-cd4759c92698
		summarizeBy: none
		sourceColumn: event_id

	column 'Job ID'
		dataType: string
		lineageTag: 29d1414f-f9af-53de-9eaf-4193498ceb45
		summarizeBy: none
		sourceColumn: job_id

	column 'Event date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 68cac5e4-7135-5008-a178-32f3e93705c4
		summarizeBy: none
		sourceColumn: event_date

	column 'Event type'
		dataType: string
		lineageTag: 9b9375f1-e7bf-5641-8b6f-0f718e30e4bc
		summarizeBy: none
		sourceColumn: event_type

	column Severity
		dataType: string
		lineageTag: eb93d8da-4c90-5eef-91f4-d5e9b510ae03
		summarizeBy: none
		sourceColumn: severity

	column Description
		dataType: string
		lineageTag: b8b698d0-f11f-5751-9d1c-dab8d8a2597c
		summarizeBy: none
		sourceColumn: description

	column 'Reported by'
		dataType: string
		lineageTag: 3438aa7b-612e-54ba-9bbf-aa508c31f0bc
		summarizeBy: none
		sourceColumn: reported_by

	partition 'HSE event' = entity
		mode: directLake
		source
			entityName: facthseevent
			schemaName: dbo
			expressionSource: DatabaseQuery
