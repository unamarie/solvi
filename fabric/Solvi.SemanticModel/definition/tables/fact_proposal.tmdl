table fact_proposal
	lineageTag: 566e3674-908a-5d23-9f49-f5dd2c843fdb

	measure Proposals = COUNTROWS ( fact_proposal )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 9d765374-ab66-58c0-8c7c-1fe19654301a

	measure 'Won proposals' = CALCULATE ( COUNTROWS ( fact_proposal ), fact_proposal[status] = "Won" )
		formatString: #,0
		displayFolder: Sales
		lineageTag: c38de1e2-538d-51b5-96c0-de3283a1dfb1

	measure 'Win rate' = DIVIDE ( [Won proposals], CALCULATE ( COUNTROWS ( fact_proposal ), fact_proposal[status] IN { "Won", "Lost", "Expired" } ) )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 5a825573-fabb-5037-9ae8-bec0f7990cef

	measure 'Proposal value' = SUM ( fact_proposal[proposal_total_nok] )
		formatString: #,0 "kr"
		displayFolder: Sales
		lineageTag: 3de8a3ac-b8d2-56ba-b1d5-7d657396197c

	measure 'Median days to first follow-up' = MEDIAN ( fact_proposal[days_to_first_followup] )
		formatString: #,0.0
		displayFolder: Sales
		lineageTag: 633ec31c-2aca-55a9-9813-5cf90ebd0f17

