table 'Risk factor'
	lineageTag: 56d53a22-7db4-580d-b29f-9ca309153f51

	measure 'Risk factors found' = COUNTROWS ( 'Risk factor' )
		formatString: #,0
		displayFolder: Risk
		lineageTag: 2fa68927-c3be-54f1-a919-85ba3dc3d772

	measure 'Stop factors found' = CALCULATE ( COUNTROWS ( 'Risk factor' ), 'Risk factor'[Stops work] = 1 )
		formatString: #,0
		displayFolder: Risk
		lineageTag: bede21e1-976b-5837-8033-cd9ef5d685e1

	column 'Factor code'
		dataType: string
		lineageTag: 4c23635c-40c1-5bfd-9522-2997325cd94f
