		sourceColumn: factor_code

	column 'Job ID'
		dataType: string
		lineageTag: 7b796e41-3488-5e83-ba8d-3dbb26983a54
		summarizeBy: none
		sourceColumn: job_id

	column Factor
		dataType: string
		lineageTag: bd585882-f45a-5f84-acdd-54c440c85799
		summarizeBy: none
		sourceColumn: factor

	column Category
		dataType: string
		lineageTag: fb27209f-c0c8-52fa-9dd6-aaf49732003e
		summarizeBy: none
		sourceColumn: category

	column Weight
		dataType: int64
		lineageTag: d1010014-a91d-5950-9e48-2f500135d68b
		summarizeBy: none
		sourceColumn: weight

	column 'Stops work'
		dataType: int64
		lineageTag: 0be5b9c3-d864-54d0-8d53-793c7fa907f1
		summarizeBy: none
		sourceColumn: stops_work

	partition 'Risk factor' = entity
		mode: directLake
		source
			entityName: factjobriskfactor
			schemaName: dbo
			expressionSource: DatabaseQuery
