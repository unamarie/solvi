table Proposal
	lineageTag: f671ad1a-9f03-5f76-830e-5b5e7b39f1b2

	measure Proposals = COUNTROWS ( 'Proposal' )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 20bab7b9-4f4f-57c8-9df7-496e8fd5c5e3

	measure 'Won proposals' = CALCULATE ( COUNTROWS ( 'Proposal' ), 'Proposal'[Status] = "Won" )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 09df17d0-41e1-51e0-8a2c-3731e6731014

	measure 'Win rate' = DIVIDE ( [Won proposals], CALCULATE ( COUNTROWS ( 'Proposal' ), 'Proposal'[Status] IN { "Won", "Lost", "Expired" } ) )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 03fea1a6-194e-5273-92eb-48c33b6866a1

	measure 'Proposal value' = SUM ( 'Proposal'[Proposal total NOK] )
		formatString: #,0 "kr"
		displayFolder: Sales
		lineageTag: 8e4a4a58-bd9d-55d4-af03-639077673564

	measure 'Median days to first follow-up' = MEDIAN ( 'Proposal'[Days to first followup] )
		formatString: #,0.0
		displayFolder: Sales
		lineageTag: 147c05e5-5e3a-5b65-9079-6d314dfc63a7

