table Deviation
	lineageTag: 79355c87-7021-5a6d-a3e6-1cee72115436

	measure 'Open deviations' = CALCULATE ( COUNTROWS ( 'Deviation' ), 'Deviation'[Is open] = TRUE () )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 2d3e520e-51ef-5c08-8108-d8f5b086ec41

	measure 'Open high deviations' = CALCULATE ( [Open deviations], 'Deviation'[Severity] = "High" )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 8eefcea8-29b5-5edf-81cb-3f273ff24a9d

	measure 'Average days open' = AVERAGE ( 'Deviation'[Days open] )
		formatString: #,0.0
		displayFolder: Compliance
		lineageTag: 2f7a3cc9-aa76-5db3-80f4-4489f6925c00

