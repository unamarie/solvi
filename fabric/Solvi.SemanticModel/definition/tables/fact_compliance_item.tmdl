table fact_compliance_item
	lineageTag: e4202a4d-b373-5cd0-ad1e-07785507f00d

	measure 'Compliance items' = COUNTROWS ( fact_compliance_item )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 384160ea-0d66-54c2-a55f-afddc5ab4634

	measure 'Overdue items' = CALCULATE ( COUNTROWS ( fact_compliance_item ), fact_compliance_item[status] = "Overdue" )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 4bbb58a4-400a-55e6-947e-f5dd5bde2b08

	measure 'On-time share' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_compliance_item ), fact_compliance_item[status] = "On time" ), CALCULATE ( COUNTROWS ( fact_compliance_item ), fact_compliance_item[status] IN { "On time", "Late" } ) )
		formatString: 0.0%
		displayFolder: Compliance
		lineageTag: 3e9993ba-e7e2-5428-9731-8c12bd91dfb4

	column item_id
		dataType: string
		lineageTag: 23836a10-8145-5515-9d3d-9699ec77268c
		summarizeBy: none
		sourceColumn: item_id

	column installation_id
		dataType: string
		lineageTag: 6ec20136-678b-517a-9cec-b18142c970ea
		summarizeBy: none
		sourceColumn: installation_id

	column requirement_id
		dataType: string
		lineageTag: 66a4d334-424d-5d18-a6a7-1fff73fb5127
		summarizeBy: none
		sourceColumn: requirement_id

	column due_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 057ba0c6-6d03-54bb-b731-04c5f2dcaf11
		summarizeBy: none
		sourceColumn: due_date

	column submitted_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: d14a5731-1601-5401-8a6f-3fd9ee59dca4
		summarizeBy: none
		sourceColumn: submitted_date

	column status
		dataType: string
		lineageTag: 8f85a5ff-800a-5f02-b2aa-6ee4d0169e27
		summarizeBy: none
		sourceColumn: status

	partition fact_compliance_item = entity
		mode: directLake
		source
			entityName: fact_compliance_item
			schemaName: dbo
			expressionSource: DatabaseQuery
