table fact_inspection_deviation
	lineageTag: 81460475-af14-54b5-b76c-dc0c7ac6171b

	measure 'Open deviations' = CALCULATE ( COUNTROWS ( fact_inspection_deviation ), fact_inspection_deviation[is_open] = TRUE () )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 5b9b6627-53af-5274-8ed0-2ded52314c33

	measure 'Open high deviations' = CALCULATE ( [Open deviations], fact_inspection_deviation[severity] = "High" )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 8462ddf1-167b-51fa-9eb8-2d9effcc88a1

	measure 'Average days open' = AVERAGE ( fact_inspection_deviation[days_open] )
		formatString: #,0.0
		displayFolder: Compliance
		lineageTag: e73b76e7-8813-56fe-bc2b-b4418436cf69

