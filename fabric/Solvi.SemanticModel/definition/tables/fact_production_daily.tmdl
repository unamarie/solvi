table fact_production_daily
	lineageTag: fdd4c633-bbdd-5652-9997-1b380717bdc7

	measure 'Production kWh' = SUM ( fact_production_daily[kwh] )
		formatString: #,0 "kWh"
		displayFolder: Production
		lineageTag: f2310b05-c407-5ccb-980d-4253ccb78b1f

	measure 'Expected kWh' = SUM ( fact_production_daily[expected_kwh] )
		formatString: #,0 "kWh"
		displayFolder: Production
		lineageTag: 2a297c99-e17e-5b14-bded-fed40cf36fb5

	measure 'Performance ratio' = DIVIDE ( [Production kWh], [Expected kWh] )
		formatString: 0.0%
		displayFolder: Production
		lineageTag: 7fdc2909-2ef4-52a1-adce-23be2ca21050

	measure 'Underperforming installations' = CALCULATE ( DISTINCTCOUNT ( fact_production_daily[installation_id] ), fact_production_daily[underperforming] = TRUE () )
		formatString: #,0
		displayFolder: Production
		lineageTag: 0f6c53c1-8976-5f4c-b7de-79f109342cd7

	column installation_id
		dataType: string
		lineageTag: ce498fe0-1c12-54dd-ae6b-6a5cd86f3b9d
		summarizeBy: none
		sourceColumn: installation_id

	column date
